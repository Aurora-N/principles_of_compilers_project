}

/* Style the tab using the tab sub-control. Note that
    it reads QTabBar _not_ QTabWidget */
QTabBar::tab {
    background-color: none;
    border-radius: 0px;
    min-width: 16ex;
    padding: 4px;
}

QTabBar::tab:selected {
    background-color: none;
    color: #0060DF;
    border-bottom: 1px solid #0060DF;
}

QTabBar::tab:hover {
    color: #0060DF;
}

QTabBar::tab:!selected {
    margin-bottom: 1px;
}</string>
